# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Dr. Rauf Neurology — Patient Consultation Portal"
API_PREFIX=/api

# Security & Authentication
# In production, generate a secure secret key: openssl rand -hex 32
SECRET_KEY=dev_secret_key_dr_rauf_neurology_portal_2026_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# PostgreSQL is the primary database architecture for this system
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dr_rauf_neurology

# Development Fallback: If PostgreSQL is not active during local development/evaluation,
# set to True to allow automatic SQLite fallback without altering the PostgreSQL architecture.
USE_SQLITE_DEV_FALLBACK=True
SQLITE_DB_PATH=./dr_rauf_dev.db

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
